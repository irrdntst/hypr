# Standard applications: one program per job, declared once.
#
# Values are desktop entry ids — the file name under /usr/share/applications
# or ~/.local/share/applications. Change one here, run tools/render.sh, and
# config/mimeapps.list follows.
#
# tools/apps.sh --check verifies on your machine that each of these exists.

BROWSER=firefox.desktop
FILE_MANAGER=thunar.desktop
IMAGE_VIEWER=imv.desktop
VIDEO_PLAYER=mpv.desktop
PDF_VIEWER=org.pwmt.zathura.desktop
TEXT_EDITOR=ampere-text-editor.desktop   # ships in share/applications: nvim inside kitty
ARCHIVER=xarchiver.desktop
