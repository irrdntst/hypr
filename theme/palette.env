# The palette. Everything visual in this repo is generated from this file.
#
# Edit a value here, run tools/theme.sh, commit the result. Editing a
# generated config directly works until the next render, then it is lost.
#
# Colours are bare hex without '#', so a template can wrap them in whatever
# syntax it needs: #@BG@ for CSS, rgb(@BG@) for hyprland, 0x@BG@ for Lua.

# --- Core ---------------------------------------------------------------
BG=16181d          # window and bar background
SURFACE=1e2128     # raised surfaces: notifications, input fields
BORDER=2a2e38      # borders and inactive window frames
TEXT=d4d6dd        # primary text
MUTED=7a8091       # secondary text, inactive labels
ACCENT=7aa2c7      # focused window, selection, clock
URGENT=c06a6a      # errors, critical notifications, urgent workspaces
WARN=d1a35c        # warnings, low battery

# --- Terminal palette ---------------------------------------------------
ANSI_BLACK=2a2e38
ANSI_RED=c06a6a
ANSI_GREEN=8aa872
ANSI_YELLOW=d1a35c
ANSI_BLUE=7aa2c7
ANSI_MAGENTA=a68cc4
ANSI_CYAN=78b0ab
ANSI_WHITE=d4d6dd
ANSI_BRIGHT_BLACK=3a3f4b
ANSI_BRIGHT_RED=d08585
ANSI_BRIGHT_GREEN=9dbb85
ANSI_BRIGHT_YELLOW=ddb87c
ANSI_BRIGHT_BLUE=93b5d6
ANSI_BRIGHT_MAGENTA=b9a3d4
ANSI_BRIGHT_CYAN=92c3be
ANSI_BRIGHT_WHITE=e8eaf0

# --- Typography ---------------------------------------------------------
FONT=JetBrainsMono Nerd Font
FONT_FALLBACK=DejaVu Sans Mono
FONT_SIZE=12
TERM_FONT_SIZE=11.0
