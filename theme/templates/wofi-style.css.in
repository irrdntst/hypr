/* GENERATED from theme/templates/wofi-style.css.in by tools/theme.sh.
   Edit the template or theme/palette.env, then re-run it. */

/* wofi. */

window {
  background-color: #@BG@;
  border: 1px solid #@BORDER@;
  font-family: "@FONT@", "@FONT_FALLBACK@", monospace;
  font-size: 13px;
}

#input {
  margin: 6px;
  padding: 6px 8px;
  background-color: #@SURFACE@;
  border: 1px solid #@BORDER@;
  color: #@TEXT@;
}

#input:focus {
  border: 1px solid #@ACCENT@;
  outline: none;
}

#inner-box,
#outer-box,
#scroll {
  background-color: transparent;
  border: none;
}

#entry {
  padding: 5px 8px;
  color: #@TEXT@;
}

#entry:selected {
  background-color: #@ACCENT@;
  color: #@BG@;
}

#text:selected {
  color: #@BG@;
}
