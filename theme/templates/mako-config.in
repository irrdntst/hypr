# GENERATED from theme/templates/mako-config.in by tools/theme.sh.
# Edit the template or theme/palette.env, then re-run it.

# mako. https://man.archlinux.org/man/mako.5

font=@FONT@ 10
background-color=#@SURFACE@
text-color=#@TEXT@
border-color=#@BORDER@
border-size=1
border-radius=0

anchor=top-right
margin=6
padding=10
width=340
height=110
default-timeout=6000
max-visible=5
icons=1

# Toggled with SUPER+SHIFT+N (makoctl mode -t do-not-disturb).
[mode=do-not-disturb]
invisible=1

[urgency=low]
text-color=#@MUTED@

[urgency=critical]
border-color=#@URGENT@
default-timeout=0
