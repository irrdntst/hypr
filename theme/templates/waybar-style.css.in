/* GENERATED from theme/templates/waybar-style.css.in by tools/theme.sh.
   Edit the template or theme/palette.env, then re-run it. */

/* Waybar. */

@define-color bg      #@BG@;
@define-color surface  #@SURFACE@;
@define-color border   #@BORDER@;
@define-color text     #@TEXT@;
@define-color muted    #@MUTED@;
@define-color accent   #@ACCENT@;
@define-color urgent   #@URGENT@;

* {
  font-family: "@FONT@", "@FONT_FALLBACK@", monospace;
  font-size: @FONT_SIZE@px;
  border: none;
  border-radius: 0;
  min-height: 0;
}

window#waybar {
  background: @bg;
  color: @text;
  border-bottom: 1px solid @border;
}

#workspaces button {
  padding: 0 8px;
  color: @muted;
  background: transparent;
}

#workspaces button.active {
  color: @bg;
  background: @accent;
}

#workspaces button.urgent {
  color: @bg;
  background: @urgent;
}

#workspaces button:hover {
  background: @surface;
  color: @text;
  /* Waybar draws a box-shadow on hover by default; kill it. */
  box-shadow: none;
  text-shadow: none;
}

#submap {
  color: @bg;
  background: @accent;
  padding: 0 8px;
}

#window {
  color: @muted;
}

#language,
#bluetooth,
#pulseaudio,
#network,
#cpu,
#memory,
#custom-gpu,
#battery,
#clock {
  padding: 0 6px;
}

#clock {
  color: @accent;
}

#battery.warning {
  color: #@WARN@;
}

#battery.critical {
  color: @urgent;
}

#network.disconnected {
  color: @urgent;
}

#tray {
  padding: 0 6px;
}
