// Waybar. https://github.com/Alexays/Waybar/wiki/Configuration
// Deliberately plain: text labels instead of icons, so nothing depends on a
// font being installed, and low poll intervals so the bar costs nothing.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 10,

  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "hyprland/language",
    "bluetooth",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "custom/gpu",
    "battery",
    "tray",
    "clock"
  ],

  "hyprland/workspaces": {
    "format": "{id}",
    "sort-by": "number",
    "on-click": "activate"
  },

  "hyprland/submap": {
    "format": "[{}]",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 70,
    "separate-outputs": true,
    "tooltip": false
  },

  "hyprland/language": {
    "format": "{short}",
    "tooltip": false
  },

  // Hides itself when the machine has no bluetooth controller.
  "bluetooth": {
    "format": "bt {status}",
    "format-disabled": "",
    "format-no-controller": "",
    "format-connected": "bt {num_connections}",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol --",
    "format-bluetooth": "bt {volume}%",
    // Add "on-click": "pavucontrol" here if you install the optional GUI mixer.
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname} {ipaddr}",
    "on-click": "nm-connection-editor",
    "interval": 10
  },

  // Clicking any of the three opens the resource monitor, same as SUPER+Escape.
  "cpu": {
    "format": "cpu {usage}%",
    "interval": 5,
    "on-click": "kitty --class monitor -e btop"
  },

  "memory": {
    "format": "ram {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G of {total:0.1f}G",
    "on-click": "kitty --class monitor -e btop"
  },

  // NVIDIA only. nvidia-smi comes with nvidia-utils; on a machine without it
  // the module stays empty instead of erroring.
  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "format": "gpu {}%",
    "interval": 5,
    "tooltip": false,
    "on-click": "kitty --class monitor -e btop"
  },

  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "bat {capacity}%",
    "format-charging": "bat {capacity}% +",
    "format-plugged": "ac",
    "tooltip-format": "{timeTo}"
  },

  "tray": {
    "spacing": 10
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d.%m}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
